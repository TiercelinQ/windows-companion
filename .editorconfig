root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{xaml,csproj,props,targets,pubxml,resx,xml,manifest}]
indent_size = 2

[*.xaml]
indent_size = 4

[*.cs]
indent_size = 4

# Layout
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error
dotnet_sort_system_directives_first = true

# Unused usings are errors (needs GenerateDocumentationFile, set in Directory.Build.props)
dotnet_diagnostic.IDE0005.severity = error

# var only when the type is apparent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Braces always
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# Naming: PascalCase members and constants, _camelCase private instance fields
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.members.applicable_kinds = class, struct, interface, enum, delegate, method, property, event

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = error
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_pascal.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.members_pascal.symbols = members
dotnet_naming_rule.members_pascal.style = pascal_case
dotnet_naming_rule.members_pascal.severity = error
dotnet_diagnostic.IDE1006.severity = error

# ConfigureAwait (rules/threading.md): mandatory in Services, Models, Helpers; forbidden in ViewModels and Views.
dotnet_diagnostic.CA2007.severity = none

[src/WindowsCompanion.Wpf/{Services,Models,Helpers}/**.cs]
dotnet_diagnostic.CA2007.severity = error

# Generated accessor of Strings.resx: its static field follows the resource-generator convention.
[src/WindowsCompanion.Wpf/Resources/Strings.Designer.cs]
generated_code = true

# Tests follow the code under test (rules/threading.md) and use French behavior names (rules/tests.md).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# xUnit1051 also flags the NSubstitute arrange and verify calls (Returns, Received), which are not operations of the test
# and cannot take the test token; the calls under test do pass TestContext.Current.CancellationToken.
dotnet_diagnostic.xUnit1051.severity = none
