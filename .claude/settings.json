{
  "permissions": {
    "allow": [
      "Bash(dotnet:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/secrets/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Write(**/bin/**)",
      "Write(**/obj/**)",
      "Write(publish/**)",
      "Write(**/artifacts/**)"
    ]
  },
  "hooks": {
    "Stop": [{ "hooks": [{ "type": "command", "command": "dotnet format --verify-no-changes --no-restore" }] }]
  }
}
