<Project>
  <!--
    Portable distribution (rules/packaging.md): one self-contained executable, no runtime to install.
    Command, from the repository root, with the application closed (a running instance locks its executable):
      dotnet publish src/WindowsCompanion.Wpf -c Release -p:PublishProfile=win-x64
    The project path is mandatory: published from the solution, the test project would fail with NETSDK1151.
  -->
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- No .NET runtime prerequisite on the target machine. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF native libraries go inside the single file instead of next to it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Faster cold start, larger binary. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF is not trim-safe (reflection over XAML types). Never set to true. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The published folder holds the executable and nothing else. -->
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- The XML doc file is built for the analyzers (IDE0005), not shipped. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
