        <Setter Property="Margin" Value="{StaticResource EmptyStatePadding}" />
    </Style>

    <Style x:Key="UpdatesEmptyStateStyle" TargetType="StackPanel" BasedOn="{StaticResource EmptyStatePanelStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
