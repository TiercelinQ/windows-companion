<!-- ============================================================
     Styles.xaml - Windows Companion v1.0.0
     Reference: design-system.md v1.0 (WPF) - layout.md v1.1 - 03-surfaces.md
     Resource references only: no literal color, size or duration (rules/xaml.md).
     Themed brushes are Fluent keys with DynamicResource. Templated controls are BasedOn their implicit style.
     ============================================================ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:WindowsCompanion.Models"
    xmlns:res="clr-namespace:WindowsCompanion.Resources">

    <!-- ============================ SHELL ============================ -->

    <!-- tokens: TextFillColorPrimaryBrush, FontFamilyDefault, FontSizeBase - Mica backdrop (design-system.md, layout.md §2) -->
    <Style x:Key="AppWindowStyle" TargetType="ui:FluentWindow" BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
        <Setter Property="WindowBackdropType" Value="Mica" />
        <Setter Property="WindowCornerPreference" Value="Round" />
    </Style>

    <!-- tokens: TitleBarHeight -->
    <Style x:Key="AppTitleBarStyle" TargetType="ui:TitleBar" BasedOn="{StaticResource {x:Type ui:TitleBar}}">
        <Setter Property="Height" Value="{StaticResource TitleBarHeight}" />
        <Setter Property="ShowHelp" Value="False" />
    </Style>

    <!-- tokens: Spacing1 -->
    <Style x:Key="TitleHeaderPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Spacing1}" />
    </Style>

    <!-- tokens: IconButtonPadding, Spacing1 - icon-only, transparent (C-03) -->
    <Style x:Key="TitleBarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource IconButtonPadding}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidthNone}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Spacing1}" />
    </Style>

    <!-- tokens: BrandMarkSize, Spacing2Horizontal (C-04). The source (Assets/icon.png) is assigned from the
         code-behind of MainWindow: the decode size must be set before the source (rules/packaging.md). -->
    <Style x:Key="BrandImageStyle" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource BrandMarkSize}" />
        <Setter Property="Height" Value="{StaticResource BrandMarkSize}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2Horizontal}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <!-- tokens: FontSizeXs, FontWeightSemiBold -->
    <Style x:Key="BrandTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- tokens: FontWeightNormal, Spacing2Horizontal, TextFillColorTertiaryBrush - version next to the brand name -->
    <Style x:Key="BrandVersionStyle" TargetType="TextBlock" BasedOn="{StaticResource BrandTextStyle}">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2Horizontal}" />
    </Style>

    <Style x:Key="NavItemContentStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <Style x:Key="NavItemTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- tokens: Spacing2Left - count of pending updates (F-NAV-04), hidden at 0 -->
    <Style x:Key="NavBadgeStyle" TargetType="ui:InfoBadge" BasedOn="{StaticResource {x:Type ui:InfoBadge}}">
        <Setter Property="Severity" Value="Attention" />
        <Setter Property="Margin" Value="{StaticResource Spacing2Left}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPending}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: ControlStrokeColorDefaultBrush, BorderWidthTop, StatusBarPadding - transparent over Mica (zone E) -->
    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidthTop}" />
        <Setter Property="Padding" Value="{StaticResource StatusBarPadding}" />
    </Style>

    <Style x:Key="StatusItemPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- tokens: FontSizeXs, TextFillColorSecondaryBrush (layout.md §7) -->
    <Style x:Key="StatusBarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- tokens: Spacing4Left -->
    <Style x:Key="StatusBarSpacedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusBarTextStyle}">
        <Setter Property="Margin" Value="{StaticResource Spacing4Left}" />
    </Style>

    <!-- tokens: StatusDotSize, SystemFillColorSuccessBrush / SystemFillColorCriticalBrush (F-FEN-10) -->
    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource StatusDotSize}" />
        <Setter Property="Height" Value="{StaticResource StatusDotSize}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2Right}" />
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Updates.IsWingetMissing}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: IconSizeSm, TextFillColorSecondaryBrush, Spacing1 -->
    <Style x:Key="StatusIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="{StaticResource IconSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2Right}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Standard rights: the rights item is a button "Relancer en administrateur" (F-FEN-12) -->
    <Style x:Key="StatusRelaunchButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource Spacing2Horizontal}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidthNone}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: Spacing2Horizontal, BorderWidthNone - the winget item is a button that opens the Store page (transparent, same look as the text) -->
    <Style x:Key="StatusWingetButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource Spacing2Horizontal}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidthNone}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusAdminPanelStyle" TargetType="StackPanel" BasedOn="{StaticResource StatusItemPanelStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ PAGES ============================ -->

    <!-- The NavigationView presenter drops its own scroll host when the page sets CanContentScroll=False (rules/xaml.md) -->
    <Style x:Key="PageStyle" TargetType="Page" BasedOn="{StaticResource {x:Type Page}}">
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- tokens: PageHeaderMargin (zone C, fixed above the scroll) -->
    <Style x:Key="PageHeaderStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource PageHeaderMargin}" />
    </Style>

    <!-- tokens: PageHeaderSpacedMargin - header whose command bar wraps (Updates) -->
    <Style x:Key="SpacedPageHeaderStyle" TargetType="Grid" BasedOn="{StaticResource PageHeaderStyle}">
        <Setter Property="Margin" Value="{StaticResource PageHeaderSpacedMargin}" />
    </Style>

    <Style x:Key="PageHeaderPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource PageHeaderMargin}" />
    </Style>

    <!-- tokens: FontFamilyDisplay, FontSize2Xl, FontWeightSemiBold -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize2Xl}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- tokens: FontSizeSm, TextFillColorSecondaryBrush, Spacing1Top -->
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{StaticResource Spacing1Top}" />
    </Style>

    <!-- Command bar (C-12): buttons carry CommandItemMargin, lines wrap -->
    <Style x:Key="CommandBarPanelStyle" TargetType="WrapPanel">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="{StaticResource Spacing4Left}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- tokens: CommandSeparatorWidth/Height, ControlStrokeColorDefaultBrush, CommandSeparatorMargin (C-13) -->
    <Style x:Key="CommandSeparatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="{StaticResource CommandSeparatorWidth}" />
        <Setter Property="Height" Value="{StaticResource CommandSeparatorHeight}" />
        <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="{StaticResource CommandSeparatorMargin}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageScrollStyle" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- tokens: PageContentMargin (zone D; the right margin pairs with CardMargin) -->
    <Style x:Key="PageContentStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource PageContentMargin}" />
    </Style>

    <!-- tokens: PageContentMargin - page content that fills the height (Updates, E-03) -->
    <Style x:Key="PageContentGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource PageContentMargin}" />
    </Style>

    <Style x:Key="LoadingPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="{StaticResource Spacing4Bottom}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ BUTTONS ============================ -->

    <!-- design-system.md §9 - CommandItemMargin -->
    <Style x:Key="PrimaryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Primary" />
        <Setter Property="Margin" Value="{StaticResource CommandItemMargin}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="Margin" Value="{StaticResource CommandItemMargin}" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Margin" Value="{StaticResource CommandItemMargin}" />
    </Style>

    <!-- tokens: SystemFillColorCriticalBrush - "Annuler tout" -->
    <Style x:Key="DangerTextButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- "Nouvelle analyse" / "Analyse en cours" (F-MAT-03) -->
    <Style x:Key="AnalyzeButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Content" Value="{x:Static res:Strings.Hw_Analyze}" />
        <Setter Property="Icon" Value="{ui:SymbolIcon ArrowSync24}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                <Setter Property="Content" Value="{x:Static res:Strings.Hw_Analyzing}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: SystemFillColorCriticalBrush once armed (F-HIS-07) -->
    <Style x:Key="ClearHistoryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource GhostButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsClearArmed}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: SmallButtonPadding, FontSizeSm -->
    <Style x:Key="SmallButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="Padding" Value="{StaticResource SmallButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GhostHeaderButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- ============================ SURFACES ============================ -->

    <!-- tokens: CardBackgroundFillColorDefaultBrush, CardStrokeColorDefaultBrush, BorderWidth, CornerRadiusMd, CardPadding, CardMargin (C-22) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="{StaticResource CardMargin}" />
    </Style>

    <Style x:Key="CardPaddedStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}" />

    <!-- tokens: Spacing0 - the table fills the card -->
    <Style x:Key="TableCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource Spacing0}" />
    </Style>

    <Style x:Key="NoMatchCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasNoMatch}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: FontSizeMd, FontWeightSemiBold, Spacing3Bottom -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Margin" Value="{StaticResource Spacing3Bottom}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BlockHeaderStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource Spacing3Bottom}" />
    </Style>

    <!-- tokens: FontSizeMd, FontWeightSemiBold, Spacing3Left -->
    <Style x:Key="BlockTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Margin" Value="{StaticResource Spacing3Left}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- tokens: IconTileSize, CornerRadiusMd, ControlFillColorSecondaryBrush -->
    <Style x:Key="IconSquareStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource IconTileSize}" />
        <Setter Property="Height" Value="{StaticResource IconTileSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- tokens: IconSizeMd, TextFillColorSecondaryBrush -->
    <Style x:Key="IconSquareIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="{StaticResource IconSizeMd}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Overview tiles: 4 columns, 2 at 1100 or less. Bound to the shell through the application: a page hosted in the
         NavigationView frame does not reach the Window with a FindAncestor binding. -->
    <Style x:Key="TileGridStyle" TargetType="UniformGrid">
        <Setter Property="Columns" Value="{Binding MainWindow.DataContext.TileColumns, Source={x:Static Application.Current}}" />
        <Setter Property="Margin" Value="{StaticResource TileGridMargin}" />
    </Style>

    <!-- Cards: 2 columns, 1 at 1100 or less -->
    <Style x:Key="CardGridStyle" TargetType="UniformGrid">
        <Setter Property="Columns" Value="{Binding MainWindow.DataContext.ContentColumns, Source={x:Static Application.Current}}" />
    </Style>

    <!-- tokens: TileMargin, TilePadding (C-27) -->
    <Style x:Key="TileStyle" TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
        <Setter Property="Margin" Value="{StaticResource TileMargin}" />
        <Setter Property="Padding" Value="{StaticResource TilePadding}" />
        <Setter Property="IsChevronVisible" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <!-- tokens: FontSizeSm, TextFillColorSecondaryBrush -->
    <Style x:Key="TileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- tokens: FontFamilyDisplay, FontSizeDisplay, FontWeightSemiBold -->
    <Style x:Key="TileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Margin" Value="{StaticResource Spacing1Top}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- tokens: FontFamilyDefault, FontSizeMd, TextFillColorSecondaryBrush -->
    <Style x:Key="TileUnitRunStyle" TargetType="Run">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightNormal}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- tokens: FontSizeXs, TextFillColorSecondaryBrush -->
    <Style x:Key="TileDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- tokens: FontFamilyDisplay, FontSizeLg, FontWeightSemiBold, Spacing2Right -->
    <Style x:Key="SummaryTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2Right}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SummarySecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================ TEXT ============================ -->

    <Style x:Key="BodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBase}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="StrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- tokens: FontSizeSm, TextFillColorSecondaryBrush -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="SecondaryRightTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SecondaryInlineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Margin" Value="{StaticResource Spacing2Left}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- tokens: FontSizeXs, TextFillColorSecondaryBrush (tertiary text is decorative only, design-system.md §12) -->
    <Style x:Key="TertiaryRightTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="{StaticResource Spacing2Left}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="CaptionRightTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- tokens: FontFamilyMono, FontSizeXs, TextFillColorSecondaryBrush -->
    <Style x:Key="IdentifierTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IdentifierWrapTextStyle" TargetType="TextBlock" BasedOn="{StaticResource IdentifierTextStyle}">
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppNameTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============================ LISTS ============================ -->

    <Style x:Key="CardBodyItemsStyle" TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}" />

    <!-- Card list on 2 columns, 1 at 1100 or less -->
    <Style x:Key="CardItemsStyle" TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding MainWindow.DataContext.ContentColumns, Source={x:Static Application.Current}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlockItemsStyle" TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}" />

    <!-- tokens: ListLinePadding, DividerStrokeColorDefaultBrush, BorderWidthTop - no line above the first item -->
    <Style x:Key="ListLineStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource ListLinePadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidthTop}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
