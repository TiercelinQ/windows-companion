    <Style x:Key="HistoryEmptyStateStyle" TargetType="StackPanel" BasedOn="{StaticResource UpdatesEmptyStateStyle}" />

    <!-- tokens: IconSizeXl, SystemFillColorSuccessBrush - only for "Tout est à jour" -->
    <Style x:Key="EmptyIconUpToDateStyle" TargetType="ui:SymbolIcon">
