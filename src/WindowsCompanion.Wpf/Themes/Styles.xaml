    <!-- tokens: IconTileSize, CornerRadiusMd, Spacing3Left (C-31) -->
    <Style x:Key="AppTileStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource IconTileSize}" />
        <Setter Property="Height" Value="{StaticResource IconTileSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Margin" Value="{StaticResource Spacing3Left}" />
