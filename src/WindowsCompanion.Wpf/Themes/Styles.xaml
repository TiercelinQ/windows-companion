        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource Spacing1Top}" />
    </Style>

    <!-- winget log (C-35, E-03): monospace, colored lines, fills its block, scrolls both ways (no wrapping) -->
    <Style x:Key="LogItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="{StaticResource Spacing2Horizontal}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style x:Key="WingetLogStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidthNone}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LogItemStyle}" />
    </Style>

    <Style x:Key="LogLineStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeXs}" />
        <Setter Property="LineHeight" Value="{StaticResource LeadingLogLine}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogLineKind.Command}">
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogLineKind.Success}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogLineKind.Error}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ INPUTS AND SETTINGS ============================ -->

    <!-- tokens: FilterBoxWidth, CommandItemMargin -->
    <Style x:Key="FilterBoxStyle" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Width" Value="{StaticResource FilterBoxWidth}" />
        <Setter Property="Margin" Value="{StaticResource CommandItemMargin}" />
        <Setter Property="Icon" Value="{ui:SymbolIcon Search24}" />
    </Style>

    <!-- Segmented control (C-17): track outlined with the control stroke, chips; the checked chip takes the accent
         (ControlFillColorDefaultBrush, ControlStrokeColorDefaultBrush, AccentFillColorDefaultBrush, TextOnAccentFillColorPrimaryBrush) -->
    <Style x:Key="SegmentedTrackStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource SegmentedPadding}" />
        <Setter Property="Margin" Value="{StaticResource CommandItemMargin}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingSegmentedStyle" TargetType="Border" BasedOn="{StaticResource SegmentedTrackStyle}">
        <Setter Property="Margin" Value="{StaticResource Spacing0}" />
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chip" Background="Transparent" CornerRadius="{StaticResource CornerRadiusSm}" Padding="{StaticResource SegmentPadding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Setting row (C-36): control docked right, text fills; a separator line above each row -->
    <Style x:Key="SettingRowStyle" TargetType="DockPanel">
        <Setter Property="Margin" Value="{StaticResource Spacing3Vertical}" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>

    <Style x:Key="SettingTextPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource Spacing2Right}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingToggleStyle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="DockPanel.Dock" Value="Right" />
    </Style>

    <Style x:Key="NoExclusionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasExclusions}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Only a disabled adapter offers "Activer l'adaptateur" (A5) -->
    <Style x:Key="EnableAdapterButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="{StaticResource Spacing3Top}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Info.IsDisabled}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ TOASTS (D-01) ============================ -->

    <!-- tokens: ToastWidth, ToastHostMargin - bottom right, captures no pointer outside the toasts (TS-10, TS-15) -->
    <Style x:Key="ToastHostStyle" TargetType="UserControl">
        <Setter Property="Width" Value="{StaticResource ToastWidth}" />
        <Setter Property="Margin" Value="{StaticResource ToastHostMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="ToastStackStyle" TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Opaque surface per type (TS-30), thicker border for an error (TS-32); entry 240 ms, exit 180 ms unless Windows reduces animations.
         Clipped to its rounded corners from the code-behind (ToastHost.OnToastSizeChanged): ClipToBounds ignores CornerRadius. -->
    <Style x:Key="ToastStyle" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource ToastItemMargin}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth}" />
        <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Success}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Warning}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Danger}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource BorderWidthEmphasis}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                    <Condition Binding="{Binding IsClosing}" Value="False" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="{StaticResource OpacityHidden}" To="{StaticResource OpacityVisible}" Duration="{StaticResource TransitionSlow}" EasingFunction="{StaticResource EaseOut}" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="{StaticResource ToastSlideIn}" To="{StaticResource OffsetNone}" Duration="{StaticResource TransitionSlow}" EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                    <Condition Binding="{Binding IsClosing}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="{StaticResource OpacityHidden}" Duration="{StaticResource TransitionToastExit}" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="{StaticResource ToastSlideOut}" Duration="{StaticResource TransitionToastExit}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: ToastPadding -->
    <Style x:Key="ToastContentGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource ToastPadding}" />
    </Style>

    <!-- tokens: IconTileSize, CornerRadiusMd - badge colored by type -->
    <Style x:Key="ToastBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource IconTileSize}" />
        <Setter Property="Height" Value="{StaticResource IconTileSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusMd}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Success}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Warning}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Danger}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: IconSizeMd, TextOnAccentFillColorPrimaryBrush - icon by type (TS-31) -->
    <Style x:Key="ToastBadgeIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="{StaticResource IconSizeMd}" />
        <Setter Property="Filled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Symbol" Value="Info24" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Success}">
                <Setter Property="Symbol" Value="Checkmark24" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Warning}">
                <Setter Property="Symbol" Value="Warning24" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Danger}">
                <Setter Property="Symbol" Value="Dismiss24" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: FontSize2Xs, FontWeightBold - colored by type -->
    <Style x:Key="ToastKickerStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize2Xs}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Success}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Warning}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Danger}">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToastTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ToastMessageStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Margin" Value="{StaticResource Spacing1Top}" />
    </Style>

    <!-- tokens: ToastCloseSize -->
    <Style x:Key="ToastCloseButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource ToastCloseSize}" />
        <Setter Property="Height" Value="{StaticResource ToastCloseSize}" />
        <Setter Property="Padding" Value="{StaticResource Spacing0}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidthNone}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="ToastActionsStyle" TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
        <Setter Property="Margin" Value="{StaticResource Spacing2Top}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasActions}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: SmallButtonPadding, FontSizeSm, ToastActionMargin - the primary action in accent -->
    <Style x:Key="ToastActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="Padding" Value="{StaticResource SmallButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Margin" Value="{StaticResource ToastActionMargin}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                <Setter Property="Appearance" Value="Primary" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- tokens: ToastTimerHeight - shrinks with the remaining time (TS-23), hidden for an error and when Windows reduces animations -->
    <!-- tokens: AccentFillColorDefaultBrush, OpacityToastInfoTint - blue tint of the information toast, the other types
         having their own Fluent background brush (U-01) -->
    <Style x:Key="ToastInfoTintStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Opacity" Value="{StaticResource OpacityToastInfoTint}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Info}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToastTimerStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource ToastTimerHeight}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Success}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:FeedbackType.Warning}">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasTimer}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
