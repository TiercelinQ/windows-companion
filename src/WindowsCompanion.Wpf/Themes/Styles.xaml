    <!-- Row actions (cahier 4.3, cell Action): each shown in its state only -->
    <Style x:Key="RowButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource SmallButtonStyle}">
        <Setter Property="Margin" Value="{StaticResource Spacing2Horizontal}" />
        <Setter Property="Visibility" Value="Collapsed" />
