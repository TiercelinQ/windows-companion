    <!-- tokens: Spacing3Top - action of the "winget introuvable" empty state, shown only when winget is missing (F-LIM-01) -->
    <Style x:Key="EmptyActionButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Margin" Value="{StaticResource Spacing3Top}" />
