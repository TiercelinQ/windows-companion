    <Style x:Key="RowInstallButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource RowButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="{x:Static models:UpdateState.Available}">
