<!-- ============================================================
     Tokens.xaml - Windows Companion v1.0.0
     Reference: design-system.md v1.0 (WPF) - cahier des charges 6.4/6.5 (D-04)
     Theme-independent values. Themed colors are the Fluent brushes, referenced by key with DynamicResource
     in Styles.xaml (an alias declared here would freeze the light value). No palette override (D-05).
     ============================================================ -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- TYPOGRAPHY (cahier 6.4, D-04) -->
    <FontFamily x:Key="FontFamilyDefault">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyDisplay">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize2Xs">11</sys:Double>
    <sys:Double x:Key="FontSizeXs">12</sys:Double>
    <sys:Double x:Key="FontSizeSm">12.5</sys:Double>
    <sys:Double x:Key="FontSizeBase">13</sys:Double>
    <sys:Double x:Key="FontSizeMd">14</sys:Double>
    <sys:Double x:Key="FontSizeLg">15</sys:Double>
    <sys:Double x:Key="FontSize2Xl">22</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>
    <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <sys:Double x:Key="LeadingLogLine">18.6</sys:Double>

    <!-- SPACING (design-system.md §3) -->
    <Thickness x:Key="Spacing0">0</Thickness>
    <Thickness x:Key="Spacing1">4</Thickness>
    <Thickness x:Key="Spacing2">8</Thickness>
    <Thickness x:Key="Spacing3">12</Thickness>
    <Thickness x:Key="Spacing4">16</Thickness>
    <Thickness x:Key="Spacing6">24</Thickness>
    <Thickness x:Key="Spacing1Top">0,4,0,0</Thickness>
    <Thickness x:Key="Spacing1Bottom">0,0,0,4</Thickness>
    <Thickness x:Key="Spacing2Top">0,8,0,0</Thickness>
    <Thickness x:Key="Spacing2Bottom">0,0,0,8</Thickness>
    <Thickness x:Key="Spacing2Left">8,0,0,0</Thickness>
    <Thickness x:Key="Spacing2Right">0,0,8,0</Thickness>
    <Thickness x:Key="Spacing3Top">0,12,0,0</Thickness>
    <Thickness x:Key="Spacing3Bottom">0,0,0,12</Thickness>
    <Thickness x:Key="Spacing3Left">12,0,0,0</Thickness>
    <Thickness x:Key="Spacing4Left">16,0,0,0</Thickness>
    <Thickness x:Key="Spacing4Bottom">0,0,0,16</Thickness>
    <Thickness x:Key="Spacing2Horizontal">8,0</Thickness>
    <Thickness x:Key="Spacing3Horizontal">12,0</Thickness>
    <Thickness x:Key="Spacing1Vertical">0,4</Thickness>
    <Thickness x:Key="Spacing2Vertical">0,8</Thickness>
    <Thickness x:Key="Spacing3Vertical">0,12</Thickness>
    <!-- Command bar: 6 between buttons, 6 between wrapped lines (cahier 3.4) -->
    <Thickness x:Key="CommandItemMargin">6,6,0,0</Thickness>
    <Thickness x:Key="CommandSeparatorMargin">10,10,4,4</Thickness>
    <!-- Page header 18 24 12, content 4 24 28 (cahier 3.2) -->
    <Thickness x:Key="PageHeaderMargin">24,18,24,12</Thickness>
    <!-- Updates page: its command bar wraps on two lines when the pane is open, 8 more before the summary (U-07) -->
    <Thickness x:Key="PageHeaderSpacedMargin">24,18,24,20</Thickness>
    <!-- The content right margin is 8: every card adds its own 16 gap on the right, 24 in total -->
    <Thickness x:Key="PageContentMargin">24,4,8,28</Thickness>
    <!-- Cards: 16 between blocks -->
    <Thickness x:Key="CardMargin">0,0,16,16</Thickness>
    <Thickness x:Key="CardPadding">16,14,16,16</Thickness>
    <!-- Tiles: 12 between tiles; the grid adds 4 so the last tile ends 24 from the edge -->
    <Thickness x:Key="TilePadding">16,14</Thickness>
    <Thickness x:Key="TileMargin">0,0,12,12</Thickness>
    <Thickness x:Key="TileGridMargin">0,0,4,4</Thickness>
    <Thickness x:Key="DiskBlockPadding">14</Thickness>
    <Thickness x:Key="DiskBlockMargin">0,12,12,0</Thickness>
    <Thickness x:Key="DiskGridMargin">0,0,-12,0</Thickness>
    <Thickness x:Key="ListLinePadding">0,9</Thickness>
    <Thickness x:Key="TableCellPadding">12,6</Thickness>
    <Thickness x:Key="PillPadding">9,2</Thickness>
    <Thickness x:Key="SmallButtonPadding">12,4</Thickness>
    <Thickness x:Key="IconButtonPadding">6</Thickness>
    <Thickness x:Key="SegmentedPadding">2</Thickness>
    <Thickness x:Key="SegmentPadding">12,4</Thickness>
    <Thickness x:Key="StatusBarPadding">12,0</Thickness>
    <Thickness x:Key="EmptyStatePadding">16,36</Thickness>
    <Thickness x:Key="ToastPadding">12,12,8,14</Thickness>
    <!-- Toast zone: 16 from the window edges, above the status bar (26) and below the title bar (40) -->
    <Thickness x:Key="ToastHostMargin">16,56,16,42</Thickness>
    <Thickness x:Key="ToastItemMargin">0,8,0,0</Thickness>
    <Thickness x:Key="ToastActionMargin">0,0,6,0</Thickness>

    <!-- FIXED SIZES (design-system.md §4, cahier 6.5 - D-04) -->
    <sys:Double x:Key="TitleBarHeight">40</sys:Double>
    <GridLength x:Key="TitleBarRowHeight">40</GridLength>
    <GridLength x:Key="StatusBarRowHeight">26</GridLength>
    <sys:Double x:Key="NavPaneWidth">244</sys:Double>
    <sys:Double x:Key="NavPaneCompactWidth">48</sys:Double>
    <sys:Double x:Key="FilterBoxWidth">240</sys:Double>
    <sys:Double x:Key="BrandMarkSize">18</sys:Double>
    <sys:Double x:Key="IconTileSize">32</sys:Double>
    <sys:Double x:Key="StatusDotSize">8</sys:Double>
    <sys:Double x:Key="GaugeHeight">8</sys:Double>
    <sys:Double x:Key="ProgressBarHeight">4</sys:Double>
    <sys:Double x:Key="RowProgressWidth">120</sys:Double>
    <sys:Double x:Key="ActivityRingSize">14</sys:Double>
    <sys:Double x:Key="LogMaxHeight">150</sys:Double>
    <sys:Double x:Key="ToastWidth">388</sys:Double>
    <sys:Double x:Key="ToastCloseSize">28</sys:Double>
    <sys:Double x:Key="ToastTimerHeight">3</sys:Double>
    <sys:Double x:Key="DialogMinWidth">480</sys:Double>
    <sys:Double x:Key="UpdateRowMinHeight">54</sys:Double>
    <sys:Double x:Key="HistoryRowMinHeight">44</sys:Double>
    <sys:Double x:Key="TableHeaderHeight">34</sys:Double>
    <sys:Double x:Key="CommandSeparatorHeight">20</sys:Double>
    <sys:Double x:Key="CommandSeparatorWidth">1</sys:Double>
    <sys:Double x:Key="IconSizeXs">12</sys:Double>
    <sys:Double x:Key="IconSizeSm">14</sys:Double>
    <sys:Double x:Key="IconSizeMd">18</sys:Double>
    <sys:Double x:Key="IconSizeLg">24</sys:Double>
    <sys:Double x:Key="IconSizeXl">36</sys:Double>

    <!-- COLUMNS (cahier 4.3, 4.7) -->
    <DataGridLength x:Key="CheckColumnWidth">48</DataGridLength>
    <DataGridLength x:Key="AppColumnWidth">2.2*</DataGridLength>
    <sys:Double x:Key="AppColumnMinWidth">190</sys:Double>
    <DataGridLength x:Key="VersionColumnWidth">92</DataGridLength>
    <DataGridLength x:Key="SourceColumnWidth">74</DataGridLength>
    <DataGridLength x:Key="SizeColumnWidth">76</DataGridLength>
    <DataGridLength x:Key="StateColumnWidth">1.9*</DataGridLength>
    <sys:Double x:Key="StateColumnMinWidth">210</sys:Double>
    <DataGridLength x:Key="DateColumnWidth">128</DataGridLength>
    <DataGridLength x:Key="HistoryAppColumnWidth">2*</DataGridLength>
    <DataGridLength x:Key="HistoryVersionColumnWidth">1.4*</DataGridLength>
    <DataGridLength x:Key="ResultColumnWidth">130</DataGridLength>
    <DataGridLength x:Key="DurationColumnWidth">70</DataGridLength>
    <GridLength x:Key="LabelColumnWidth">9*</GridLength>
    <GridLength x:Key="ValueColumnWidth">13*</GridLength>
    <GridLength x:Key="TestIconColumnWidth">24</GridLength>
    <GridLength x:Key="ToastBadgeColumnWidth">36</GridLength>
    <GridLength x:Key="ToastCloseColumnWidth">28</GridLength>

    <!-- SHAPE (design-system.md §5): two radii only; circles are ellipses -->
    <CornerRadius x:Key="CornerRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMd">8</CornerRadius>
    <Thickness x:Key="BorderWidth">1</Thickness>
    <Thickness x:Key="BorderWidthNone">0</Thickness>
    <Thickness x:Key="BorderWidthTop">0,1,0,0</Thickness>
    <Thickness x:Key="BorderWidthEmphasis">2</Thickness>

    <!-- OPACITY (design-system.md §5) -->
    <sys:Double x:Key="OpacityDisabled">0.4</sys:Double>
    <!-- Accent tint of the information toast, over the opaque application background (U-01) -->
    <sys:Double x:Key="OpacityToastInfoTint">0.14</sys:Double>

    <!-- TRANSITIONS: toast entry and exit (cahier des toasts 5.6, D-01) -->
    <Duration x:Key="TransitionSlow">0:0:0.24</Duration>
    <Duration x:Key="TransitionToastExit">0:0:0.18</Duration>
    <sys:Double x:Key="ToastSlideIn">32</sys:Double>
    <sys:Double x:Key="ToastSlideOut">24</sys:Double>
    <sys:Double x:Key="OpacityHidden">0</sys:Double>
    <sys:Double x:Key="OpacityVisible">1</sys:Double>
    <sys:Double x:Key="OffsetNone">0</sys:Double>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

    <!-- Z-ORDER (design-system.md §13) -->
    <sys:Int32 x:Key="ZContent">0</sys:Int32>
    <sys:Int32 x:Key="ZDialog">210</sys:Int32>
    <sys:Int32 x:Key="ZSnackbar">400</sys:Int32>

    <!-- APPLICATION TILES (cahier annexe B.1, F-MAJ-10): fixed in both themes, white letters, contrast >= 5.2 -->
    <SolidColorBrush x:Key="AppTile0Brush" Color="#B9460A" />
    <SolidColorBrush x:Key="AppTile1Brush" Color="#0B5FB0" />
    <SolidColorBrush x:Key="AppTile2Brush" Color="#2D3A4A" />
    <SolidColorBrush x:Key="AppTile3Brush" Color="#A85205" />
    <SolidColorBrush x:Key="AppTile4Brush" Color="#B23A1A" />
    <SolidColorBrush x:Key="AppTile5Brush" Color="#3F7A24" />
    <SolidColorBrush x:Key="AppTile6Brush" Color="#1856D6" />
    <SolidColorBrush x:Key="AppTile7Brush" Color="#5C2D91" />
    <SolidColorBrush x:Key="AppTile8Brush" Color="#0A4FD6" />
    <SolidColorBrush x:Key="AppTile9Brush" Color="#17783A" />
    <SolidColorBrush x:Key="AppTileTextBrush" Color="#FFFFFF" />
</ResourceDictionary>
