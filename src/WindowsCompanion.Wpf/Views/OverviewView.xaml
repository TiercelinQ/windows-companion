<Page
    x:Class="WindowsCompanion.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:WindowsCompanion.Models"
    xmlns:res="clr-namespace:WindowsCompanion.Resources"
    xmlns:vm="clr-namespace:WindowsCompanion.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}"
    Style="{StaticResource PageStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Nav_Overview}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{Binding Subtitle}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Style="{StaticResource CommandBarPanelStyle}">
                <ui:Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Static res:Strings.Ovw_SearchUpdates}" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding SearchUpdatesCommand}" />
                <ui:Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.Ovw_ExportReport}" Icon="{ui:SymbolIcon Share24}" Command="{Binding ExportReportCommand}" />
            </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollStyle}">
            <StackPanel Style="{StaticResource PageContentStyle}">

                <!-- Tiles (F-ACC-04 to 07): 4 columns, 2 at 1100 or less -->
                <UniformGrid Style="{StaticResource TileGridStyle}">
                    <ui:CardAction Style="{StaticResource TileStyle}" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static models:PageKey.Updates}" Icon="{ui:SymbolIcon ArrowDownload24}" AutomationProperties.Name="{x:Static res:Strings.Nav_Updates}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabelStyle}" Text="{x:Static res:Strings.Nav_Updates}" />
                            <TextBlock Style="{StaticResource TileValueStyle}" Text="{Binding UpdatesValue}" />
                            <TextBlock Style="{StaticResource TileDetailStyle}" Text="{Binding UpdatesDetail}" />
                        </StackPanel>
                    </ui:CardAction>
                    <ui:CardAction Style="{StaticResource TileStyle}" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static models:PageKey.Hardware}" Icon="{ui:SymbolIcon DeveloperBoard24}" AutomationProperties.Name="{x:Static res:Strings.Ovw_Processor}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabelStyle}" Text="{x:Static res:Strings.Ovw_Processor}" />
                            <TextBlock Style="{StaticResource TileValueStyle}">
                                <Run Text="{Binding CpuValue, Mode=OneWay}" /><Run Style="{StaticResource TileUnitRunStyle}" Text="{x:Static res:Strings.Common_PercentUnit}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource TileDetailStyle}" Text="{Binding CpuDetail}" />
                        </StackPanel>
                    </ui:CardAction>
                    <ui:CardAction Style="{StaticResource TileStyle}" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static models:PageKey.Hardware}" Icon="{ui:SymbolIcon Board24}" AutomationProperties.Name="{x:Static res:Strings.Ovw_Memory}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabelStyle}" Text="{x:Static res:Strings.Ovw_Memory}" />
                            <TextBlock Style="{StaticResource TileValueStyle}">
                                <Run Text="{Binding MemoryValue, Mode=OneWay}" /><Run Style="{StaticResource TileUnitRunStyle}" Text="{x:Static res:Strings.Common_PercentUnit}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource TileDetailStyle}" Text="{Binding MemoryDetail}" />
                        </StackPanel>
                    </ui:CardAction>
                    <ui:CardAction Style="{StaticResource TileStyle}" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static models:PageKey.Network}" Icon="{ui:SymbolIcon Globe24}" AutomationProperties.Name="{x:Static res:Strings.Nav_Network}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TileLabelStyle}" Text="{x:Static res:Strings.Nav_Network}" />
                            <TextBlock Style="{StaticResource TileValueStyle}" Text="{Binding NetworkValue}" />
                            <TextBlock Style="{StaticResource TileDetailStyle}" Text="{Binding NetworkDetail}" />
                        </StackPanel>
                    </ui:CardAction>
                </UniformGrid>

                <UniformGrid Style="{StaticResource CardGridStyle}">
                    <!-- Recommended actions (F-ACC-10 to 15) -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="{x:Static res:Strings.Ovw_Actions}" />
                            <ItemsControl ItemsSource="{Binding Recommendations}" Style="{StaticResource CardBodyItemsStyle}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RecommendedAction}">
                                        <Border Style="{StaticResource ListLineStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource ActionIconSquareStyle}">
                                                    <ui:SymbolIcon Style="{StaticResource ActionIconStyle}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Style="{StaticResource ListTextPanelStyle}">
                                                    <TextBlock Style="{StaticResource StrongTextStyle}" Text="{Binding Title}" />
                                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding Detail}" />
                                                </StackPanel>
                                                <ui:Button
                                                    Grid.Column="2"
                                                    Style="{StaticResource SmallButtonStyle}"
                                                    Content="{Binding ButtonLabel}"
                                                    Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding Target}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Storage (F-ACC-16 to 19) -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="{x:Static res:Strings.Ovw_Storage}" />
                                <ui:Button Style="{StaticResource GhostHeaderButtonStyle}" Content="{x:Static res:Strings.Action_Details}" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static models:PageKey.Hardware}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Volumes}" Style="{StaticResource CardBodyItemsStyle}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VolumeRow}">
                                        <Border Style="{StaticResource ListLineStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Style="{StaticResource StrongTextStyle}" Text="{Binding Title}" />
                                                    <TextBlock Style="{StaticResource SecondaryRightTextStyle}" Text="{Binding UsedText}" />
                                                </Grid>
                                                <ProgressBar Style="{StaticResource GaugeStyle}" Value="{Binding Percent, Mode=OneWay}" AutomationProperties.Name="{Binding GaugeName}" />
                                                <Grid>
                                                    <TextBlock Style="{StaticResource UsageTextStyle}" Text="{Binding PercentText}" />
                                                    <TextBlock Style="{StaticResource SecondaryRightTextStyle}" Text="{Binding FreeText}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
