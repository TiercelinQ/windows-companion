<Page
    x:Class="WindowsCompanion.Views.SystemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:res="clr-namespace:WindowsCompanion.Resources"
    xmlns:vm="clr-namespace:WindowsCompanion.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SystemViewModel}"
    Style="{StaticResource PageStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource PageHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="{x:Static res:Strings.Nav_System}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="{x:Static res:Strings.Sys_Subtitle}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Style="{StaticResource CommandBarPanelStyle}">
                <ui:TextBox
                    Style="{StaticResource FilterBoxStyle}"
                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{x:Static res:Strings.Sys_FilterPlaceholder}"
                    AutomationProperties.Name="{x:Static res:Strings.Sys_FilterName}" />
                <ui:Button Style="{StaticResource SecondaryButtonStyle}" Content="{x:Static res:Strings.Common_Export}" Icon="{ui:SymbolIcon Share24}" Command="{Binding ExportCommand}" />
                <ui:Button Style="{StaticResource GhostButtonStyle}" Content="{x:Static res:Strings.Common_CopySummary}" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopySummaryCommand}" />
            </WrapPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollStyle}">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <StackPanel Style="{StaticResource LoadingPanelStyle}">
                    <ui:ProgressRing Style="{StaticResource ActivityRingStyle}" />
                    <TextBlock Style="{StaticResource SecondaryInlineTextStyle}" Text="{x:Static res:Strings.Common_Reading}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Cards}" Style="{StaticResource CardItemsStyle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SystemCard}">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Rows}" Style="{StaticResource InfoRowsStyle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource NoMatchCardStyle}">
                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                        <TextBlock Style="{StaticResource EmptyTitleStyle}" Text="{x:Static res:Strings.Sys_NoMatchTitle}" />
                        <TextBlock Style="{StaticResource EmptyTextStyle}" Text="{x:Static res:Strings.Sys_NoMatchText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
